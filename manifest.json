{
  "schemaVersion": 1,
  "id": "ai.kub0.agent",
  "name": "kub0",
  "version": "0.5.1",
  "author": "kub0-ai",
  "license": "MIT",
  "description": "Live per-app outbound connection map with country flags and one-key per-app firewall blocks.",
  "kinds": ["service", "bar-widget", "panel"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "kub0",
    "description": "Live per-app outbound connection map",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
